# ─────────────────────────────────────────────────────────────────────────
# PRODUCTION build-time env for cenaps.in
#
# IMPORTANT: NEXT_PUBLIC_* values are inlined into the client bundle at BUILD
# time (during `next build`), NOT read at runtime. So these must be present
# when the frontend is built — set them in your platform's build env, or pass
# them as Docker --build-arg (see Dockerfile). Rebuild after changing them.
# ─────────────────────────────────────────────────────────────────────────

# Must point at the backend API, including the /api/v1 prefix.
NEXT_PUBLIC_API_URL=https://api.cenaps.in/api/v1

NEXT_PUBLIC_APP_NAME=Hospital ERP

# Razorpay LIVE publishable key id (client-side checkout).
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
